# Prospect Dominion customer deployment template
# Copy this file to .env and replace every customer-specific value before startup.

APP_ENV=local
PUBLIC_BASE_URL=http://localhost

# Customer identity and white-label configuration
PD_BRAND_NAME=Prospect Dominion
PD_BRAND_TAGLINE=Operational control surface
PD_PRIMARY_COLOR=#4f8ef7

# Local pilot credentials only. Use generated production secrets for a real deployment.
PD_API_KEY=dev-local-key
JWT_SECRET=change-me

# Host ports
API_PORT=8010
PD_PORT=8010
OSINT_PORT=8081
REDIS_PORT=6380

# Data services
PG_USER=aethonex
PG_PASSWORD=change-me-strong
PG_DB=prospect_dominion
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong
REDIS_PASSWORD=change-me-strong

# Supporting services
LITELLM_MASTER_KEY=sk-local-change-me
N8N_ENCRYPTION_KEY=change-me
LANGFUSE_PUBLIC_KEY=pk-...
LANGFUSE_SECRET_KEY=sk-...
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
GRAFANA_PASSWORD=change-me
