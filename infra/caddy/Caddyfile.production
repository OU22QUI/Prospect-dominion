# Copy to the customer deployment and set PD_PUBLIC_HOST to the pilot's DNS name.
# Caddy obtains/renews TLS only when DNS and ports 80/443 are reachable.
{$PD_PUBLIC_HOST} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
    reverse_proxy api:8000
}
